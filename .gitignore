# Raw sequence data and downloads (never commit)
*.fna
*.fasta
*.fa
*.fas
*.gbk
*.gbff
*.fna.gz
data/genomes_downloaded/*
data/plasmids_downloaded/*
data/blast_databases/*
!data/genomes_downloaded/.gitkeep
!data/plasmids_downloaded/.gitkeep
!data/blast_databases/.gitkeep
# BLAST database files
*.nhr
*.nin
*.nsq
*.ndb
*.not
*.ntf
*.nto
*.njs
*.nos
*.nog
*.nsd
*.nsi
# Small final oligo FASTAs are allowed
!results/final_assay/*.fasta
# Nextflow
work/
.nextflow/
.nextflow.log*
# Python / notebooks
__pycache__/
*.pyc
.ipynb_checkpoints/
.env
# OS
.DS_Store
Thumbs.db

# Generated human-readable reports (copied to OneDrive by sync_onedrive.sh)
reports/

# Small reference sequences are tracked; raw fastANI output is regenerable
!data/reference/*.fasta
results/genome_qc/fastani_all_vs_all.tsv
results/genome_qc/genome_list.txt
results/annotation/*/
results/annotation/logs/
